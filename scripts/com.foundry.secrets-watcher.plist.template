<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.foundry.secrets-watcher</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__FOUNDRY_DIR__/scripts/secrets-watcher.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>FOUNDRY_WORKSPACE_DIR</key>
        <string>__WORKSPACE_DIR__</string>
        <key>PROTON_PASS_KEY_PROVIDER</key>
        <string>env</string>
        <key>PROTON_PASS_ENCRYPTION_KEY</key>
        <string>__PROTON_PASS_ENCRYPTION_KEY__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/foundry-secrets-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/foundry-secrets-watcher.log</string>
</dict>
</plist>
